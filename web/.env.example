# ---- Google Sheet with RFID taps (columns: Timestamp, RFID UID, Name) ----
# Sheet ID = the long string in docs.google.com/spreadsheets/d/<ID>/edit
SHEET_ID=
TAB_NAME=
# Private sheet: share it with the service account and set GOOGLE_SERVICE_ACCOUNT_JSON (one line of JSON).
# Otherwise an API key works for sheets set to "anyone with the link can view".
GOOGLE_API_KEY=
GOOGLE_SERVICE_ACCOUNT_JSON=
TIMEZONE=Asia/Kolkata
# Today counts as Absent only after this time (before it: Pending)
CUTOFF_TIME=10:00
# Comma-separated YYYY-MM-DD dates shown as Holiday (Sundays are automatic)
HOLIDAYS=
# Optional: days before this date are not counted (YYYY-MM-DD)
ATTENDANCE_START_DATE=

# ---- Login sessions ----
SESSION_SECRET=

# ---- RFID card UID per profile (also settable in web/data/rfid-map.json) ----
RFID_UID_BHARUNESH=
RFID_UID_BRANESH=
RFID_UID_HEMANTH=
RFID_UID_SABITHA=
RFID_UID_ANNIE=

# ---- Coding activity ----
GITHUB_USERNAME=
LEETCODE_USERNAME=

THIRD_PLATFORM=codeforces
THIRD_USERNAME=
GITHUB_TOKEN=

# Google Apps Script web-app URL (keep secret)
GAS_URL=
