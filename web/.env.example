# Google Sheets attendance
GOOGLE_API_KEY=
GOOGLE_SHEET_ID=
GOOGLE_SHEET_RANGE=Attendance!A:Z

# Coding activity / attendance (usernames can also be overridden per user in the app's Setup dialog)
GITHUB_USERNAME=
LEETCODE_USERNAME=
THIRD_PLATFORM=codeforces
THIRD_USERNAME=
# Optional: GitHub token with read:user. Without it, a public contributions proxy is used ("limited data").
GITHUB_TOKEN=

# Google Apps Script web-app URL (keep secret)
GAS_URL=
